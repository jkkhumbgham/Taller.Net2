@page "/"
@rendermode InteractiveServer

<PageTitle>Dashboard - E-Learning Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Dashboard</h1>
    <span class="badge bg-primary fs-6">
        Arquitectura: @NombreArquitectura
    </span>
</div>

@if (Cargando)
{
    <CargandoIndicador Mensaje="Cargando estadísticas..." />
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="var(--bs-primary)" class="bi bi-people-fill" viewBox="0 0 16 16">
                            <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                            <path fill-rule="evenodd" d="M5.216 14A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216z"/>
                            <path d="M4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-muted mb-1 small">Total Usuarios</p>
                        <h2 class="mb-0 fw-bold">@TotalUsuarios</h2>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/usuarios" class="text-decoration-none small">Ver usuarios &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="var(--bs-success)" class="bi bi-book-fill" viewBox="0 0 16 16">
                            <path d="M8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-muted mb-1 small">Total Cursos</p>
                        <h2 class="mb-0 fw-bold">@TotalCursos</h2>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/cursos" class="text-decoration-none small">Ver cursos &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="var(--bs-warning)" class="bi bi-journal-check" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M10.854 6.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 8.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                            <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2z"/>
                            <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-muted mb-1 small">Total Inscripciones</p>
                        <h2 class="mb-0 fw-bold">@TotalInscripciones</h2>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/inscripciones" class="text-decoration-none small">Ver inscripciones &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-semibold">Accesos rápidos</div>
                <div class="card-body">
                    <div class="d-flex flex-column gap-2">
                        <a href="/usuarios/nuevo" class="btn btn-outline-primary btn-sm text-start">+ Nuevo usuario</a>
                        <a href="/cursos/nuevo" class="btn btn-outline-success btn-sm text-start">+ Nuevo curso</a>
                        <a href="/inscripciones" class="btn btn-outline-warning btn-sm text-start">+ Nueva inscripción</a>
                        <a href="/estadisticas" class="btn btn-outline-info btn-sm text-start">Ver estadísticas</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-semibold">Arquitectura actual</div>
                <div class="card-body">
                    <p class="mb-2">Selecciona la arquitectura de backend desde el menú lateral.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge @(SelectorArquitectura.ArquitecturaSeleccionada == TipoArquitectura.Monolitico ? "bg-primary" : "bg-secondary")">Monolítico</span>
                        <span class="badge @(SelectorArquitectura.ArquitecturaSeleccionada == TipoArquitectura.Servicios ? "bg-primary" : "bg-secondary")">Servicios</span>
                        <span class="badge @(SelectorArquitectura.ArquitecturaSeleccionada == TipoArquitectura.MicroServicios ? "bg-primary" : "bg-secondary")">Microservicios</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
