<div class="dropdown">
    <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-diagram-3 me-2" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M6 3.5A1.5 1.5 0 0 1 7.5 2h1A1.5 1.5 0 0 1 10 3.5v1A1.5 1.5 0 0 1 8.5 6v1H14a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0V8h-5v.5a.5.5 0 0 1-1 0V8h-5v.5a.5.5 0 0 1-1 0v-1A.5.5 0 0 1 2 7h5.5V6A1.5 1.5 0 0 1 6 4.5v-1zm-6 8A1.5 1.5 0 0 1 1.5 10h1A1.5 1.5 0 0 1 4 11.5v1A1.5 1.5 0 0 1 2.5 14h-1A1.5 1.5 0 0 1 0 12.5v-1zm6 0A1.5 1.5 0 0 1 7.5 10h1a1.5 1.5 0 0 1 1.5 1.5v1A1.5 1.5 0 0 1 8.5 14h-1A1.5 1.5 0 0 1 6 12.5v-1zm6 0a1.5 1.5 0 0 1 1.5-1.5h1a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5v-1z"/>
        </svg>
        Arquitectura: <strong class="ms-1">@NombreArquitectura</strong>
    </a>
    <ul class="dropdown-menu dropdown-menu-dark">
        <li><button class="dropdown-item @(SelectorArquitectura.ArquitecturaSeleccionada == TipoArquitectura.Monolitico ? "active" : "")" @onclick="() => SeleccionarArquitectura(TipoArquitectura.Monolitico)">Monolítico</button></li>
        <li><button class="dropdown-item @(SelectorArquitectura.ArquitecturaSeleccionada == TipoArquitectura.Servicios ? "active" : "")" @onclick="() => SeleccionarArquitectura(TipoArquitectura.Servicios)">Servicios</button></li>
        <li><button class="dropdown-item @(SelectorArquitectura.ArquitecturaSeleccionada == TipoArquitectura.MicroServicios ? "active" : "")" @onclick="() => SeleccionarArquitectura(TipoArquitectura.MicroServicios)">Microservicios</button></li>
    </ul>
</div>

@code {
    private string NombreArquitectura => SelectorArquitectura.ArquitecturaSeleccionada switch
    {
        TipoArquitectura.Monolitico => "Monolítico",
        TipoArquitectura.Servicios => "Servicios",
        TipoArquitectura.MicroServicios => "Microservicios",
        _ => "Monolítico"
    };

    protected override void OnInitialized()
    {
        SelectorArquitectura.OnCambio += StateHasChanged;
    }

    private void SeleccionarArquitectura(TipoArquitectura tipo)
    {
        SelectorArquitectura.ArquitecturaSeleccionada = tipo;
    }

    public void Dispose()
    {
        SelectorArquitectura.OnCambio -= StateHasChanged;
    }
}
